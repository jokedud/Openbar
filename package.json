{
  "name": "openbar",
  "productName": "OpenBar",
  "version": "0.1.0",
  "description": "Open-source smart dock and taskbar replacement for Windows 10/11 with live widgets.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "OpenBar contributors",
  "homepage": "https://github.com/jokedud/openbar",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main/main.js && node scripts/check.js",
    "dist": "electron-builder --win portable nsis --x64 --publish never",
    "dist:all": "electron-builder --win portable nsis --x64 --ia32 --arm64"
  },
  "dependencies": {
    "koffi": "^2.16.4",
    "node-ical": "^0.27.6"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "xyz.openbar.app",
    "productName": "OpenBar",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json", "!**/*.map"],
    "asarUnpack": ["node_modules/koffi/**",
      "src/main/helper.ps1"],
    "win": {
      "icon": "src/renderer/assets/icon.png",
      "files": ["!node_modules/koffi/build/koffi/!(win32_${arch}){,/**}"]
    },
    "portable": { "artifactName": "OpenBar-${version}-portable-${arch}.exe", "useZip": true },
    "nsis": { "artifactName": "OpenBar-${version}-setup-${arch}.exe", "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
